10005B1C 0000001B
10005B22 0000FFFF
10005B24 0000001D
10005B2A 0000FFFF
10005B2C 0000001F
10005B32 0000FFFF
10005B34 00000021
10005B3A 0000FFFF
10005B3C 00000023
10005B42 0000FFFF

[Max All Storage Items (Except Weapons)]
; 16-bit multi-write of 9999 into 299 slots (0x2B ones), stride 8. Most
; invasive code here.
41005BDA 0000270F
412B0008 00000000

